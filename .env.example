# Optional: keys used when Connect's fields are left empty. You can leave them empty and type the keys into the page instead.
ASANA_ACCESS_TOKEN=
PLAKY_API_KEY=
# Where the app keeps its database. This is the default.
DATABASE_URL=file:./data/asana-to-plaky.db
# Optional: https://<workspace>.plaky.com, so the report links into Plaky.
PLAKY_WEB_BASE_URL=
# Optional: a paid Asana domain allows 1,500 requests a minute. The default, 140, suits a free one.
ASANA_REQUESTS_PER_MINUTE=
